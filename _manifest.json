{
  "manifest_version": 2,
  "id": "com.neal240.xiaohongshu",
  "version": "0.1.3",
  "name": "麦麦小红书",
  "description": "让麦麦浏览小红书、阅读私信，并规划发布图文。",
  "author": {"name": "Neal240", "url": "https://github.com/neal240"},
  "license": "MIT",
  "urls": {"repository": "https://github.com/neal240/maibot-xiaohongshu"},
  "host_application": {"min_version": "1.3.16", "max_version": "1.3.99"},
  "sdk": {"min_version": "2.16.0", "max_version": "2.16.99"},
  "plugin_type": "adapter",
  "dependencies": [
    {"type": "python_package", "name": "xhshow", "version_spec": "==0.2.0"},
    {"type": "python_package", "name": "curl-cffi", "version_spec": "==0.16.2"},
    {"type": "python_package", "name": "pycryptodome", "version_spec": "==4.2.0"},
    {"type": "python_package", "name": "qrcode", "version_spec": "==8.2"},
    {"type": "python_package", "name": "pillow", "version_spec": ">=12.3.0,<14.0.0"},
    {"type": "python_package", "name": "cryptography", "version_spec": ">=50.0.1,<51.0.0"}
  ],
  "capabilities": ["llm.generate"],
  "i18n": {"default_locale": "zh-CN"}
}
